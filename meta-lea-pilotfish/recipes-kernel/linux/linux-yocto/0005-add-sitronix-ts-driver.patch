+	tMode[1] = 16;
+	nRealCol = tMode[1];
+	/* SELF_UNIT */
+	tMode[5] = (cmd[0] & 0xC) >> 1;
+
+	/* NOISE_UNIT */
+	// tMode[4] = (cmd[0]&0x3)<<2;
+	tMode[4] = 0x00; // for ST7102
+
+	/* KEY */
+	tMode[3] = 0;
+	/* CMNC_CH_WR_EN */
+	tMode[7] = cmd[1] & 0x01;
+	tMode[7] = 0x00;
+	/* AA_UNIT */
+	sitronix_spi_pram_rw(true, 0xF024, NULL, cmd, 2);
+	// tMode[1] = (cmd[0]&0xF0)>>3;
+	if ((func == 1) || (func == 2))
+	{
+		tMode[1] = tMode[1] + 3;
+		// nRealCol = tMode[1];
+	}
+
