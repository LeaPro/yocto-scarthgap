+			for (row = 0; row < tMode[2]; row++)
+			{
+				buf_index += 2;
+			}
+
+			if (tMode[7] != 0)
+				buf_index += 2;
+		}
+
+		if (func == 2 || func == 1)
+		{
+#ifdef ST_SELFTEST_LOG_FILE
+			if (func == 1)
