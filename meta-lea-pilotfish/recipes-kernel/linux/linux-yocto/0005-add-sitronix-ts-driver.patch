+	unsigned char raw_dat_rd_off[2] = {0x00, 0x00};
+	unsigned char raw_header[18];
+	unsigned char frame_counter = 0;
+	int total_error = 0;
+	int error_count = 0;
+	int count_frame = 1;
+	int buf_index, aa_index;
