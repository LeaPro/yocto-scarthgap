+	frameCounter = 0;
+	retryCounter = 0;
+
+	while (ST_SELFTEST_IGNORE_FRAME > 0 && retryCounter++ < max_retry)
+	{
+		msleep(10);
+		sitronix_spi_pram_rw(false, 0xF004, raw_dat_rd_on, NULL, 2);
+		sitronix_spi_pram_rw(true, 0xF180, NULL, raw_header, 18);
+
+#ifdef __RAW_DATA_DEBUG__
+#if 0
