diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index cc18f54ea887..abe2179c33f0 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1335,4 +1335,13 @@ config TOUCHSCREEN_ZINITIX
 	  To compile this driver as a module, choose M here: the
 	  module will be called zinitix.
 
+
+config TOUCHSCREEN_SITRONIX_TS
+	tristate "Sitronix ST7102 TDDI touchscreen"
+	depends on I2C
+	help
+	  Say Y here to enable support for the Sitronix ST7102 TDDI
+	  touchscreen controller used in the Densitron DMT049W1NTCMI-1A
+	  display module.
+
 endif
