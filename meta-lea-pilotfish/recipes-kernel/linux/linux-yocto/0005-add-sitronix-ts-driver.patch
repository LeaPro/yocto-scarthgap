+					buf_index += 2;
+				}
+
+				if (tMode[7] != 0)
+					buf_index += 2;
+			}
+			// SE A
+			for (col = 0; col < tMode[5] / 2; col++)
+			{
+				for (row = 0; row < tMode[2]; row++)
+				{
+					buf_index += 2;
+				}
+
+				if (tMode[7] != 0)
+					buf_index += 2;
+			}
+			// AA B
+			for (col = tMode[1] / 2; col < tMode[1]; col++)
+			{
+				for (row = 0; row < tMode[2]; row++)
