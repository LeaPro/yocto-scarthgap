+	if (gts && gts->host_if) {
+		if (gpio_is_valid(gts->host_if->irq_gpio))
+			gpio_free(gts->host_if->irq_gpio);
+
+		if (gpio_is_valid(gts->host_if->rst_gpio))
+			gpio_free(gts->host_if->rst_gpio);
+	}
