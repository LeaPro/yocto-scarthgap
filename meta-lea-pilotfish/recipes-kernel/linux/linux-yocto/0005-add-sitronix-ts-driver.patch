+#ifdef ST_SELFTEST_LOG_FILE
+		ret = st7102_Normal_test(0, 0, filp, ppos);
+#else
+		ret = st7102_Normal_test(0, 0);
+#endif
+		if (ret == 0)
+			break;
+	}
+	return ret;
+}
