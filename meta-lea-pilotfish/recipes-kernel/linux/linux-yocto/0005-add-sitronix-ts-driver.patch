+	ret = sitronix_get_chip_id();
+	gts->ts_dev_info.chip_id = ret;
+	stmsg("IC Chip ID = 0x%X\n", ret);
+
+	ret = sitronix_get_ic_sfrver();
+	gts->ts_dev_info.chip_ver = ret;
+	stmsg("IC SFR VER = 0x%X\n", ret);
