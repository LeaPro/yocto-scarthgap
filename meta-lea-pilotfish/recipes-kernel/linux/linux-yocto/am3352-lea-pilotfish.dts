	tft-sleep-hog {
		gpio-hog;
		/* TFT_SLEEP is active-low: pin HIGH = display awake, pin LOW = display sleeping.
		 * GPIO_ACTIVE_LOW + output-low = logically deasserted = pin physically HIGH = awake. */
		gpios = <17 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "tft-sleep";
	};
};

