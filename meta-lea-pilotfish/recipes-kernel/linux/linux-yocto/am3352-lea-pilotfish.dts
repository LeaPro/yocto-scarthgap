/* enable adc inputs 0 - 7 */
/* set channel avg/opendelay/sampledelay so a single channel is sampled at approx 48KHz */
/* ADC cycles = opendelay + (sampledelay + convtime) * (avg+1), where convtime = 15 and ADC clock = ~3MHz */
&tscadc {
  status = "okay";
  adc {
    ti,adc-channels = <0 1 2 3 4 5 6 7>;
	   ti,chan-step-avg = <0 0 0 0 0 0 0 0>;
	   ti,chan-step-opendelay= <20 20 20 20 20 20 20 20>;
	   ti,chan-step-sampledelay = <27 27 27 27 27 27 27 27>;
  };
};

&usb0 {
	pinctrl-names = "default";
	pinctrl-0 = <&usb0_drvvbus_pins>;
	dr_mode = "host";
	status = "okay";
};

&usb0_phy {
	status = "okay";
};

/* -----------------------------------------------------------------------
 * Densitron DMT049W1NTCMI-1A  4.9" 480x854 RGB display
 *   - Pixel data:  AM3352 LCDC (tilcdc) parallel RGB interface
 *   - Init cmds:   panel-dmt049w1ntcmi SPI driver on SPI1 cs0
 *                  (MCASP0_AHCLKR / gpio3_17), Mode 3, 8 MHz
 *                  Driver calls SPI init sequence in drm_panel.prepare()
 *                  before LCDC starts clocking pixels.
 *   - Touch (CTP): I2C1 @ 0x55 (Sitronix ST7102 TDDI, 7-bit; 0xAA/0xAB in datasheet)
 *   - LCD reset:   GPMC_A11  / gpio1_27  (active-low, owned by SPI driver node)
 *   - CTP reset:   GPMC_AD12 / gpio1_12  (active-low)
 *   - CTP IRQ:     XDMA_EVENT_INTR0 / gpio0_19 (falling edge)
 *   - BL enable:   GPMC_AD10 / gpio0_26  (active-high, gpio-backlight)
 *
 * tilcdc connects directly to the panel-dmt049w1ntcmi SPI driver panel
 * via the port/endpoint graph (no intermediate panel-dpi node needed).
 * The SPI driver's get_modes() provides the display timings.
 * ----------------------------------------------------------------------- */
/ {
	backlight: backlight {
		compatible = "gpio-backlight";
		/* 20V boost enable: GPMC_AD10 / gpio0_26, active-high */
		gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		default-on;
		status = "okay";
	};
};

&lcdc {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&lcdc_pins>;
	port {
		lcdc_out: endpoint {
			remote-endpoint = <&lcd_panel_out>;
		};
	};
};

/* -----------------------------------------------------------------------
 * Override BBB upstream DT nodes that conflict with the Pilotfish LCD.
 *
 * am335x-boneblack-common.dtsi (pulled in via compatible="ti,am335x-bone-black")
 * declares:
 *   - mcasp0: audio codec connected to LCDC via tda19988 HDMI TX
 *   - clk_mcasp0: gpio-gate-clock using gpio1_27 (GPMC_A11) as enable
 *   - tda19988 i2c node: HDMI transmitter using the LCDC port
 *
 * On Pilotfish, GPMC_A11/gpio1_27 is the LCD panel hard-reset (LCD_RSTn),
 * and the LCDC is connected directly to the DMT049W1NTCMI-1A RGB panel -
 * not to an HDMI transmitter.  We must free gpio1_27 and disconnect the
 * upstream HDMI audio wiring so the panel driver can own the reset GPIO.
 * ----------------------------------------------------------------------- */

/* Disable McASP0 - not used, and its pinmux claims GPMC_A11/gpio1_27 */
&mcasp0 {
	status = "disabled";
};

/* Disable the TDA19988 HDMI transmitter - not present on Pilotfish */
&i2c0 {
	tda19988: tda19988@70 {
		status = "disabled";
	};
};

/* Remove the gpio-gate-clock that grabs gpio1_27 (GPMC_A11 = LCD_RSTn).
 * The clk_mcasp0 node lives in root '/' from am335x-boneblack-common.dtsi.
 * We cannot /delete-node/ a node defined in an included DTSI by label from
 * a peer DTS file, so instead strip the enable-gpios property so the clock
 * driver never requests the GPIO.  The node itself becomes a fixed pass-through. */
/ {
	/delete-node/ clk_mcasp0;
	/delete-node/ sound;
};

/* -----------------------------------------------------------------------
 * McASP1 I2S output → Dante module
 *
 * McASP1 is configured as I2S master, 2-channel, 32-bit slots at 48 kHz.
 * Serializer 1 (AXR1, pad A14) is the transmit data line.
 * The Dante module is an I2S slave receiver and requires no codec driver —
 * a dummy codec is used so the simple-audio-card machine driver can bind.
 *
 * ALSA PCM device: hw:1,0  (card "pilotfish-dante", device 0)
 * PipeWire/PulseAudio will route the BlueZ A2DP sink here automatically
 * once the card is registered.
 * ----------------------------------------------------------------------- */
/ {
	dante_codec: dante-dummy-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	sound_dante: sound-dante {
		compatible = "simple-audio-card";
		simple-audio-card,name = "pilotfish-dante";
		simple-audio-card,format = "i2s";
		/* McASP1 is I2S master: drives BCLK and LRCLK */
		simple-audio-card,bitclock-master = <&dante_cpu_dai>;
		simple-audio-card,frame-master = <&dante_cpu_dai>;

		dante_cpu_dai: simple-audio-card,cpu {
			sound-dai = <&mcasp1>;
			system-clock-frequency = <24576000>; /* 512 * 48000 Hz */
		};

		simple-audio-card,codec {
			sound-dai = <&dante_codec>;
		};
	};
};

&mcasp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcasp1_pins>;
	status = "okay";
	#sound-dai-cells = <0>;
	op-mode = <0>;		/* MCASP_IIS_MODE */
	tdm-slots = <2>;
	/* serial-dir: 0=inactive, 1=TX, 2=RX
	 * 4 serializers: ser0=inactive, ser1=TX(AXR1/A14), ser2=inactive, ser3=inactive */
	serial-dir = <0 1 0 0>;
	tx-num-evt = <32>;
	rx-num-evt = <0>;
};
