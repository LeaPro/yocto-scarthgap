//	#size-cells = <0>;
//	status = "disabled";
//};

&main_uart0 {
	bootph-all;
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart0_pins_default>;
	status = "okay";
};

&main_uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart1_pins_default>;
	status = "okay";
};

&main_uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&mikrobus_uart_pins_default>;
	status = "okay";
};

&ecap2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mikrobus_pwm_pins_default>;
};
