# LVGL Kconfig defconfig for the Trevally target build (DRM + evdev backend).
# Dropped in as ${S}/.config by lvgl-trevally_git.bb before the CMake configure
# step runs, so the port's CMakeLists.txt picks it up instead of
# configs/get_started.defconfig.
#
# Kept intentionally lean for the first working integration: core rendering,
# pthread OS layer, 32bpp color, a basic Montserrat font set, DRM (dumb-buffer
# "fbdev" backend, no GBM/EGL/mesa dependency) and evdev input. Extra
# decoders/demos from the upstream template are left disabled; enable them
# later by editing this file if application-server needs them.

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_PTHREAD=y
CONFIG_LV_COLOR_DEPTH_32=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=262144
CONFIG_LV_DRAW_THREAD_STACK_SIZE=65536
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=1024
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_USE_OBJ_NAME=y
CONFIG_LV_USE_TRANSLATION=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_CACHE_DEF_SIZE=4096
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=4096
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# --- Linux display/input backends ---
CONFIG_LV_USE_LINUX_DRM=y
# CONFIG_LV_LINUX_DRM_AUTO_BACKEND is not set
CONFIG_LV_LINUX_DRM_BACKEND_FBDEV=y
CONFIG_LV_USE_EVDEV=y
CONFIG_LV_USE_HID_ENCODER=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_STDIO_CACHE_SIZE=1024
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_SYSMON_PROC_IDLE_AVAILABLE=y

# No demos/examples on the target build.
# CONFIG_LV_BUILD_DEMOS is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
