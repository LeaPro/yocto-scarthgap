From 1d7d2c3b4a5f6e7890abcdeffedcba9876543210 Mon Sep 17 00:00:00 2001
From: LEA <lea@local>
Date: Thu, 10 Sep 2026 00:00:00 +0000
Subject: [PATCH] sound: soc: add OF match support for snd-soc-dummy

Allow Device Tree nodes using compatible "linux,snd-soc-dummy" to bind
to the snd-soc-dummy driver so simple-audio-card can reference a dummy
codec endpoint from DT phandles.

Signed-off-by: LEA <lea@local>
---
 sound/soc/soc-utils.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sound/soc/soc-utils.c b/sound/soc/soc-utils.c
index 7af2df8af08c..5f6f2e679501 100644
--- a/sound/soc/soc-utils.c
+++ b/sound/soc/soc-utils.c
@@ -250,9 +250,16 @@ static int snd_soc_dummy_probe(struct platform_device *pdev)
 	return ret;
 }
 
+static const struct of_device_id snd_soc_dummy_of_match[] = {
+	{ .compatible = "linux,snd-soc-dummy" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, snd_soc_dummy_of_match);
+
 static struct platform_driver soc_dummy_driver = {
 	.driver = {
 		.name = "snd-soc-dummy",
+		.of_match_table = snd_soc_dummy_of_match,
 	},
 	.probe = snd_soc_dummy_probe,
 };
-- 
