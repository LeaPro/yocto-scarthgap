diff --git a/drivers/mfd/tps65219.c b/drivers/mfd/tps65219.c
index 9a0318810dd2..cbc4b738787a 100644
--- a/drivers/mfd/tps65219.c
+++ b/drivers/mfd/tps65219.c
@@ -12,13 +12,6 @@
 #include <linux/mfd/core.h>
 #include <linux/mfd/tps65219.h>
 
-static int tps65219_warm_reset(struct tps65219 *tps)
-{
-	return regmap_update_bits(tps->regmap, TPS65219_REG_MFP_CTRL,
-				  TPS65219_MFP_WARM_RESET_I2C_CTRL_MASK,
-				  TPS65219_MFP_WARM_RESET_I2C_CTRL_MASK);
-}
-
 static int tps65219_cold_reset(struct tps65219 *tps)
 {
 	return regmap_update_bits(tps->regmap, TPS65219_REG_MFP_CTRL,
@@ -39,19 +32,20 @@ static int tps65219_power_off_handler(struct sys_off_data *data)
 	return NOTIFY_DONE;
 }
 
-static int tps65219_restart(struct tps65219 *tps, unsigned long reboot_mode)
+static int tps65219_restart_prepare_handler(struct sys_off_data *data)
 {
-	if (reboot_mode == REBOOT_WARM)
-		tps65219_warm_reset(tps);
-	else
-		tps65219_cold_reset(tps);
+	struct tps65219 *tps = data->cb_data;
+	int ret;
 
-	return NOTIFY_DONE;
-}
+	ret = tps65219_cold_reset(tps);
+	if (ret)
+		return NOTIFY_DONE;
 
-static int tps65219_restart_handler(struct sys_off_data *data)
-{
-	tps65219_restart(data->cb_data, data->mode);
+	/*
+	 * Issue the PMIC reset while buses are still alive in the prepare phase.
+	 * If reset does not assert, reboot continues into normal restart handlers.
+	 */
+	mdelay(250);
 	return NOTIFY_DONE;
 }
 
@@ -523,12 +517,18 @@ static int tps65219_probe(struct i2c_client *client)
 		}
 	}
 
-	ret = devm_register_restart_handler(tps->dev,
-					    tps65219_restart_handler,
+	/*
+	 * Register PMIC cold-reset request in restart-prepare phase, where
+	 * regmap/I2C access is still valid.
+	 */
+	ret = devm_register_sys_off_handler(tps->dev,
+					    SYS_OFF_MODE_RESTART_PREPARE,
+					    SYS_OFF_PRIO_HIGH,
+					    tps65219_restart_prepare_handler,
 					    tps);
 
 	if (ret) {
-		dev_err(tps->dev, "cannot register restart handler, %d\n", ret);
+		dev_err(tps->dev, "cannot register restart-prepare handler, %d\n", ret);
 		return ret;
 	}
 
