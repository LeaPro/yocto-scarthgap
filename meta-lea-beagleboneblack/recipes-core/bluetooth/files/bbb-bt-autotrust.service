[Unit]
Description=Auto-trust paired Bluetooth devices for BBB audio sink
After=bluetooth.service bbb-bt-discoverable.service
Requires=bluetooth.service bbb-bt-discoverable.service

[Service]
Type=simple
ExecStart=/usr/libexec/bbb-bt-autotrust.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
